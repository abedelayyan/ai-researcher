<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Signal Zero, {{ date }}</title>
<style>
  :root { color-scheme: light dark; --bg: #fbfbf9; --fg: #16161a; --muted: #5b5b66;
          --line: #e0e0d8; --card: #ffffff; --accent: #0b5d4e; }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #131316; --fg: #ececf1; --muted: #a0a0ad; --line: #2a2a31;
            --card: #1a1a1f; --accent: #6fd3bb; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.55 -apple-system,
         BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
  main { max-width: 820px; margin: 0 auto; padding: 32px 20px 80px; }
  h1 { font-size: 1.6rem; margin: 0 0 4px; letter-spacing: -0.01em; }
  h2 { font-size: 1.15rem; margin: 40px 0 6px; }
  .sub { color: var(--muted); font-size: 0.9rem; margin: 0 0 24px; }
  .note { border-left: 3px solid var(--accent); padding: 8px 12px; background: var(--card);
          font-size: 0.9rem; margin: 16px 0; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px;
          padding: 16px 18px; margin: 14px 0; }
  .card h3 { margin: 0 0 6px; font-size: 1.02rem; line-height: 1.35; }
  .card p { margin: 0 0 10px; }
  .meta { color: var(--muted); font-size: 0.83rem; margin: 0; }
  .pills { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0; }
  .pill { border: 1px solid var(--line); border-radius: 999px; padding: 2px 9px;
          font-size: 0.76rem; color: var(--muted); }
  .pill strong { color: var(--fg); font-weight: 600; }
  .axes { margin: 8px 0 0; padding-left: 18px; font-size: 0.85rem; color: var(--muted); }
  table { border-collapse: collapse; width: 100%; font-size: 0.88rem; }
  th, td { border-bottom: 1px solid var(--line); padding: 6px 8px; text-align: left; }
  a { color: var(--accent); }
  nav { font-size: 0.85rem; margin-bottom: 18px; }
  nav a { margin-right: 10px; }
  footer { color: var(--muted); font-size: 0.8rem; margin-top: 48px; border-top: 1px solid var(--line);
           padding-top: 12px; }
  .table-wrap { overflow-x: auto; }
</style>
</head>
<body>
<main>
  <h1>Signal Zero</h1>
  <p class="sub">{{ date }} | {{ counts.scored }} papers scored | day-zero features only,
    no upvotes, stars or citations in the ranking.</p>

  {% if recent_dates %}
  <nav>{% for d in recent_dates %}<a href="{{ nav_prefix }}{{ d }}.html">{{ d }}</a>{% endfor %}</nav>
  {% endif %}

  {% if degraded %}
  <p class="note">This run scored papers with keyword rules because no model was
    reachable. The ranking is provisional.</p>
  {% endif %}

  <h2>Confidence</h2>
  <p class="sub">Ranked by combined score, author prior included.</p>
  {% for paper in buckets.confidence %}
  <article class="card">
    <h3>{{ loop.index }}. <a href="{{ paper.abs_url }}">{{ paper.title }}</a></h3>
    <p>{{ paper.summary }}</p>
    <div class="pills">
      <span class="pill">score <strong>{{ "%.2f"|format(paper.score) }}</strong></span>
      <span class="pill">claim <strong>{{ "%.2f"|format(paper.claim_score) }}</strong></span>
      <span class="pill">prior <strong>{{ paper.prior_text }}</strong></span>
      <span class="pill">capability <strong>{{ paper.capability_total }}/12</strong></span>
      <span class="pill">compute <strong>{{ paper.compute_band }}</strong></span>
      <span class="pill">code <strong>{{ paper.code_text }}</strong></span>
    </div>
    <ul class="axes">
      {% for axis, why in paper.axis_reasons %}<li>{{ axis }}: {{ why }}</li>{% endfor %}
    </ul>
    <p class="meta">{{ paper.claim_text }} {{ paper.compute_text }}.</p>
    <p class="meta">{{ paper.authors_text }} | {{ paper.categories_text }} |
      arXiv:{{ paper.arxiv_id }}</p>
  </article>
  {% else %}
  <p>Nothing cleared the bar today.</p>
  {% endfor %}

  <h2>High variance</h2>
  <p class="sub">Unknown or low author prior, large claim, ranked on claim size alone.
    Most are noise. A prior-weighted ranking would never show them.</p>
  {% for paper in buckets.high_variance %}
  <article class="card">
    <h3>{{ loop.index }}. <a href="{{ paper.abs_url }}">{{ paper.title }}</a></h3>
    <p>{{ paper.summary }}</p>
    <div class="pills">
      <span class="pill">claim <strong>{{ "%.2f"|format(paper.claim_score) }}</strong></span>
      <span class="pill">prior <strong>{{ paper.prior_text }}</strong></span>
      <span class="pill">capability <strong>{{ paper.capability_total }}/12</strong></span>
      <span class="pill">compute <strong>{{ paper.compute_band }}</strong></span>
      <span class="pill">code <strong>{{ paper.code_text }}</strong></span>
    </div>
    <p class="meta">{{ paper.claim_text }} {{ paper.compute_text }}.</p>
    <p class="meta">{{ paper.authors_text }} | {{ paper.categories_text }} |
      arXiv:{{ paper.arxiv_id }}</p>
  </article>
  {% else %}
  <p>No paper met the claim threshold today.</p>
  {% endfor %}

  <h2>Prediction log</h2>
  {% if calibration.labelled_total %}
  <p class="sub">{{ calibration.labelled_total }} papers carry an outcome label at
    t+{{ label_horizon }}. Hits and misses both.</p>
  <div class="table-wrap">
  <table>
    <tr><th>Ranking</th><th>Runs graded</th><th>Precision@{{ calibration.k }}</th>
        <th>Base rate</th><th>Lift</th></tr>
    {% for name, stats in calibration.buckets.items() %}{% if stats.runs %}
    <tr><td>{{ name }}</td><td>{{ stats.runs }}</td>
        <td>{{ "%.2f"|format(stats.precision) }}</td>
        <td>{{ "%.2f"|format(stats.base_rate) }}</td>
        <td>{{ "%.2f"|format(stats.lift) }}x</td></tr>
    {% endif %}{% endfor %}
  </table>
  </div>
  {% else %}
  <p>No outcome labels yet. The first land {{ label_horizon }} days after the first
    scored day.</p>
  {% endif %}

  {% if lab_posts %}
  <h2>Lab posts</h2>
  <ul>{% for post in lab_posts %}<li>{{ post.lab }}:
    <a href="{{ post.url }}">{{ post.title }}</a></li>{% endfor %}</ul>
  {% endif %}

  <footer>
    Metadata from arXiv, which is CC0. Summaries are written here. Papers are linked,
    never rehosted. {{ spend.calls }} model calls this run,
    ${{ "%.4f"|format(spend.cost_usd) }}.
  </footer>
</main>
</body>
</html>
